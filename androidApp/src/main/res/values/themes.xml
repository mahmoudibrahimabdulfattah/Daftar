<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Starting theme: the system splash is the static notebook mark on the paper background. It is shown only until
        the first frame, with no delay and no wait for authentication or network. Night mode uses values-night.
    -->
    <style name="Theme.Daftar.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Daftar</item>
    </style>

    <!-- AppCompat parent: the activity is an AppCompat activity so per-app languages apply on every API level. -->
    <style name="Theme.Daftar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
