<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The only permission: the app reaches the price services. No storage, location, notification or runtime grants. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Strong biometrics only, for the optional unlock. No device credential or other grant. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- androidx.biometric also merges the legacy USE_FINGERPRINT permission, which it needs on API 26-27. -->

    <!--
        Merged by the Firebase SDKs, but unused here: Analytics reads no advertising ID, install referrer or ad
        attribution. ACCESS_NETWORK_STATE and WAKE_LOCK stay: the SDKs schedule their uploads as jobs with a network
        constraint, which throws on Android 14+ without ACCESS_NETWORK_STATE.
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission
        android:name="com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"
        tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="com.google.android.providers.gsf.permission.READ_GSERVICES" tools:node="remove" />

    <!--
        Merged from dependencies, but unused here: the app registers no dynamic receivers, so the custom
        signature permission for them is removed. Room's invalidation service runs only with multi-instance
        invalidation, which the database does not enable.
    -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <application
        android:name=".DaftarApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Daftar.Starting">
        <!-- Crash reports and analytics are on in release and off in debug, set per build type. -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="${crashlyticsCollectionEnabled}" />
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="${analyticsCollectionEnabled}" />
        <!-- Analytics only measures screen names: no advertising ID, no ad personalization and no Android ID. -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />
        <meta-data
            android:name="google_analytics_ssaid_collection_enabled"
            android:value="false" />

        <!-- Profile-install receiver: exported and guarded only by DUMP. Not part of this app's surface. -->
        <!-- The classes are merged out of the app, so they are absent from the lint classpath. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove"
            tools:ignore="MissingClass" />
        <service
            android:name="androidx.room.MultiInstanceInvalidationService"
            tools:node="remove"
            tools:ignore="MissingClass" />

        <!-- The launcher is the only exported component. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
